# Copy to .env.local for local development, or set these in Vercel → Project → Settings → Environment Variables.
# No variable is required to build. Without one of the delivery options below, the forms show an honest
# "not connected yet, please email support@nischint.care" message and nothing is stored.

# Option A: send each form submission as JSON to a webhook (CRM, Google Apps Script, Zapier, Make, n8n…)
FORMS_WEBHOOK_URL=
# Optional bearer token sent as "Authorization: Bearer <secret>" so your webhook can reject strangers
FORMS_WEBHOOK_SECRET=

# Option B: email each submission via Resend (https://resend.com). Verify the nischint.care domain there first.
RESEND_API_KEY=
FORMS_TO_EMAIL=support@nischint.care
FORMS_FROM_EMAIL=NISCHINT website <no-reply@nischint.care>
